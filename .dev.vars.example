# Copy to .dev.vars for local development (already git-ignored).
# NEVER put real secrets in this example file or in wrangler.jsonc.

# From @BotFather after creating your bot
TELEGRAM_BOT_TOKEN=

# Any long random string you invent — pass the same value when calling setWebhook
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Local AI (LM Studio server → Developer → Start server). Use your LAN IP if
# 127.0.0.1 is unreachable from the worker runtime.
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_API_KEY=lm-studio
AI_MODEL=qwen2.5-7b-instruct

# Hours offset from UTC used by bot "today" (e.g. 8 for Manila)
TELEGRAM_TZ_OFFSET_HOURS=0